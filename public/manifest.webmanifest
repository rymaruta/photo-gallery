{
  "name": "Journey Photo",
  "lang": "ja",
  "dir": "ltr",
  "short_name": "Journey Photo",
  "description": "旅の写真を共有するギャラリー",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#050e17",
  "theme_color": "#050e17",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "写真をアップロード",
      "short_name": "アップロード",
      "url": "/user/upload",
      "description": "写真をアップロードする"
    }
  ],
  "share_target": {
    "action": "/user/upload",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
