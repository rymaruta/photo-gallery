# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/api/node_modules
/api-user/node_modules
/api-user/dist
/api-user/user-api.zip
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local work dirs
/.tmp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local artifacts / backups
/_api_build_backup
/scripts/_artifacts/
/scripts/_artifacts/*.json
/app/data/_backups/
app/data/*.bak-*
app/data/photos.json.bak-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
api/.serverless/
api-user/.serverless/

# レビュー・変異テストの一時置き場（エージェントが作る）。
# 98aeeaf で `git add -A` が api-user/src/__ztmp/ を巻き込んで本番の
# パッケージに混ぜてしまった。中身は本物のソースのコピーなので、
# vitest が拾って同じテストを二重に走らせ、件数まで狂わせる。
__ztmp/
*.bak
