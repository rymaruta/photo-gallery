{
  "name": "photo-gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd api && npm run offline",
    "build": "node scripts/prepare-static-build.js",
    "start": "next start",
    "lint": "eslint",
    "type-check": "node scripts/ensure-prod-photos.js && tsc --noEmit",
    "check:all": "npm run lint && npm run type-check && npm run test:run",
    "test": "vitest",
    "test:run": "vitest run",
    "predeploy:prod": "npm run check:all",
    "upload-local-images": "tsx scripts/upload-local-images-to-s3.ts",
    "dev:upload": "tsx scripts/upload-to-dev-s3.ts",
    "add-exif": "tsx scripts/add-exif-to-existing-photos.ts",
    "api:deploy:dev": "node scripts/validate-deploy-env.js dev && cd api && npm install && npx serverless deploy --stage dev",
    "api:deploy:prod": "node scripts/validate-deploy-env.js prod && cd api && npm install && npx serverless deploy --stage prod",
    "api:info:dev": "cd api && npx serverless info --stage dev",
    "api:info:prod": "cd api && npx serverless info --stage prod",
    "check:dev-secrets": "node scripts/check-dev-secrets.js",
    "fix:dev-secrets": "node scripts/fix-dev-secrets.js",
    "check:lambda-dev": "node scripts/check-lambda-dev.js",
    "create:deployment-bucket": "node scripts/create-deployment-bucket.js",
    "web:deploy:prod": "node scripts/deploy-static-site.js",
    "fix:cloudfront-default-root": "node scripts/ensure-cloudfront-default-root.js",
    "upload:photos:prod": "node scripts/upload-photos-to-prod.js",
    "convert:photos:prod": "node scripts/write-prod-photos.js",
    "backup:prod-photos": "node scripts/backup-prod-photos.js",
    "migrate:prod-originals-and-resized": "node scripts/migrate-prod-to-originals-and-resized.js",
    "diagnose:prod": "node scripts/diagnose-prod.js",
    "security-headers": "node scripts/apply-security-headers.js",
    "check:prod-image-sizes": "node scripts/check-prod-image-sizes.js",
    "check:prod-originals-and-resized": "node scripts/check-prod-originals-and-resized.js",
    "verify:prod-images-jpeg": "node scripts/verify-prod-images-are-jpeg.js",
    "verify:prod-next-assets": "node scripts/verify-prod-next-assets.js",
    "diagnose:image": "node scripts/diagnose-single-image.js",
    "investigate": "node scripts/investigate.js",
    "investigate:prod": "node scripts/investigate.js prod",
    "investigate:images": "node scripts/investigate.js images",
    "investigate:sizes": "node scripts/investigate.js sizes",
    "prepare:og-image": "node scripts/prepare-og-image.js",
    "make:favicon": "node scripts/make-favicon-transparent.js",
    "make:favicon1": "node scripts/make-favicon-transparent.js favicon1",
    "duplicate:photos": "node scripts/duplicate-photos-json.js",
    "deploy:prod": "npm run predeploy:prod && npm run api:deploy:prod && npm run web:deploy:prod"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.970.0",
    "@aws-sdk/client-s3": "^3.970.0",
    "@aws-sdk/client-secrets-manager": "^3.970.0",
    "@aws-sdk/client-sts": "^3.970.0",
    "@aws-sdk/s3-request-presigner": "^3.970.0",
    "@heroicons/react": "^2.2.0",
    "amazon-cognito-identity-js": "^6.3.16",
    "exifr": "^7.1.3",
    "lodash.debounce": "^4.0.8",
    "next": "^16.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.5.6",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
