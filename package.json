{
  "name": "photo-gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-static-build.js",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "upload-local-images": "tsx scripts/upload-local-images-to-s3.ts",
    "dev:upload": "tsx scripts/upload-to-dev-s3.ts",
    "add-exif": "tsx scripts/add-exif-to-existing-photos.ts",
    "api:info:prod": "cd api && npx serverless info --stage prod",
    "web:deploy:prod": "node scripts/deploy-static-site.js --bucket prod-journey-photo.com"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1050.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.970.0",
    "@aws-sdk/client-dynamodb": "^3.1040.0",
    "@aws-sdk/client-lambda": "^3.970.0",
    "@aws-sdk/client-s3": "^3.970.0",
    "@aws-sdk/client-secrets-manager": "^3.970.0",
    "@aws-sdk/client-sts": "^3.970.0",
    "@aws-sdk/lib-dynamodb": "^3.1040.0",
    "@aws-sdk/s3-request-presigner": "^3.970.0",
    "@heroicons/react": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "amazon-cognito-identity-js": "^6.3.16",
    "exifr": "^7.1.3",
    "lodash.debounce": "^4.0.8",
    "mime-types": "^3.0.2",
    "next": "^16.1.1",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^29.0.2",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.4"
  }
